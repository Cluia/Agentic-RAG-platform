# Required — Gemini API key (either name works)
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here

# Qdrant (use http://qdrant:6333 inside Docker Compose)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docpulse

# Models (Google AI / Gemini)
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_DIMENSIONS=768

# Chunking & retrieval (naive RAG baseline)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=4
DATA_DIR=data
